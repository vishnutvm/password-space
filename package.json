{
  "name": "password-space",
  "version": "0.1.0",
  "private": true,
  "description": "Local credential vault for humans and AI agents — secrets via MCP, never in chat",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build && pnpm run build:plugin",
    "build:plugin": "node scripts/bundle-mcp.mjs",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint --if-present",
    "password-space": "node --no-warnings packages/cli/dist/index.js",
    "mcp": "node --no-warnings plugins/password-space/dist/index.js",
    "demo": "bash scripts/demo.sh"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "esbuild": "0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
