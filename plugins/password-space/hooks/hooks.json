{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./scripts/session-vault-hint.mjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./scripts/prompt-guard.mjs --format cursor"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./scripts/shell-guard.mjs --format cursor"
      }
    ],
    "beforeReadFile": [
      {
        "command": "./scripts/shell-guard.mjs --format cursor"
      }
    ]
  }
}
